<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 备份/设备迁移规则。配合 android:allowBackup=false（覆盖旧系统），
  确保会话令牌（love_cookies）、登录态（love_session）与服务器地址等敏感数据
  既不进云备份、也不随「设备到设备」迁移外泄。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="love_cookies.xml" />
        <exclude domain="sharedpref" path="love_cookies_enc.xml" />
        <exclude domain="sharedpref" path="love_server_config.xml" />
        <!-- love_widget carries the "days together" counter, which reveals the
             relationship start date. Although allowBackup=false is the primary
             guard, exclude it explicitly so the value cannot leak via Google
             cloud backup or device-to-device transfer on a rooted/modified
             device where allowBackup may be bypassed. -->
        <exclude domain="sharedpref" path="love_widget.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="love_cookies.xml" />
        <exclude domain="sharedpref" path="love_cookies_enc.xml" />
        <exclude domain="sharedpref" path="love_server_config.xml" />
        <exclude domain="sharedpref" path="love_widget.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
