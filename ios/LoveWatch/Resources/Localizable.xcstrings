{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "watch.days.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に過ごした日数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一起"
          }
        }
      }
    },
    "watch.days.unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天"
          }
        }
      }
    },
    "watch.heartbeat.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heartbeat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートビート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心跳"
          }
        }
      }
    },
    "watch.status.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信に失敗しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败"
          }
        }
      }
    },
    "watch.status.queued": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued — will send when iPhone is reachable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ち — iPhone と接続後に送ります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队，iPhone 可达时发送"
          }
        }
      }
    },
    "watch.status.sent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent ❤️"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信しました ❤️"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已送达 ❤️"
          }
        }
      }
    },
    "watch.tap %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tapped you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がノックしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 敲了敲你"
          }
        }
      }
    },
    "watch.tap.anon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You got a tap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノックが届きました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到一次敲一敲"
          }
        }
      }
    },
    "watch.tap.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敲一敲"
          }
        }
      }
    },
    "watch.tap.heartbeat %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sent a heartbeat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からハートビート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 发来心跳"
          }
        }
      }
    },
    "watch.tap.heartbeat.anon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You got a heartbeat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートビートが届きました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到一次心跳"
          }
        }
      }
    },
    "watch.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Love Journal on iPhone to sync your days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の「恋爱记」を開くと同期します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 打开「恋爱记」同步恋爱天数"
          }
        }
      }
    }
  },
  "version": "1.0"
}
