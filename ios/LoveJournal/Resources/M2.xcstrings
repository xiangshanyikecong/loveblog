  "strings": {
    "albums.create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Album"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建相册"
          }
        }
      }
    },
    "albums.delete.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The album will move to the recycle bin where it can be restored. Delete it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムはごみ箱に移動し、そこから復元できます。削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册将进入回收站，可从中恢复。确定删除吗？"
          }
        }
      }
    },
