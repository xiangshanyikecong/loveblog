    "cottage.chat.e2ee.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat passphrase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズを再入力"
