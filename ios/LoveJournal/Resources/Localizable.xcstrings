    },
    "cottage.chat.e2ee.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both unlock with the same passphrase; it is never uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二人とも同じパスフレーズで解除できます。サーバーへ送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两人使用同一口令即可解锁，口令不会上传服务器。"
          }
        }
      }
    },
    "cottage.chat.e2ee.locked.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat is encrypted — enter the shared passphrase to unlock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットは暗号化されています。共有パスフレーズを入力してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天已加密，输入共享口令解锁"
          }
        }
      }
    },
    "cottage.chat.e2ee.mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrases do not match"
