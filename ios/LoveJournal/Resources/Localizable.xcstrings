    "cottage.chat.e2ee.setup.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both of you encrypt chats with the same passphrase; even the server cannot read them. This cannot be undone — remember the passphrase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じパスフレーズでチャットを暗号化します。サーバーにも読めません。取り消せないため、パスフレーズを忘れないでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
