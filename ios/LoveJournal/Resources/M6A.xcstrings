        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズ（6文字以上）を設定してください。項目はこの端末で暗号化されてから送信され、サーバーには決して読み取れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置口令（至少 6 位）。条目在本机加密后才上传，服务器永远无法读取内容。"
