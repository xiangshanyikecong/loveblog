    "m6a.vault.rekey.decrypt.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some entries cannot be decrypted with the current key — rekey aborted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の鍵で復号できない項目があるため、変更を中止しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在无法用当前密钥解密的条目，已中止更换"
          }
        }
      }
    },
    "m6a.vault.rekey.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase changed and entries re-encrypted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズを変更し、項目を再暗号化しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令已更换，条目已重新加密"
          }
        }
      }
    },
    "m6a.vault.rekey.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every entry is decrypted and re-encrypted with the new passphrase before upload. Keep the new passphrase safe — it applies to both partners."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての項目を復号し、新しいパスフレーズで再暗号化してから送信します。新しいパスフレーズは二人共通です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部条目会先用当前密钥解密、再以新口令重新加密后上传。新口令双方共用，请妥善保管。"
          }
        }
      }
    },
