    },
    "widget.love.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many days you've been together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に過ごした日数を表示します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你们在一起的天数"
          }
        }
      }
    },
    "widget.love.elapsed %lld %lld %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld days %2$lld h %3$lld m together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld日 %2$lld時間 %3$lld分 一緒"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已相伴 %1$lld 天 %2$lld 时 %3$lld 分"
          }
        }
      }
    },
    "widget.love.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days Together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒の日数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一起天数"
          }
        }
      }
    },
    "widget.love.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一起"
          }
        }
