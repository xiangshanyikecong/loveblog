# ============================================
# 生产环境配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env.production
# 2. 填写所有必需的值
# 3. 确保 .env.production 在 .gitignore 中
# ============================================

# -------------------- 数据库配置 --------------------
POSTGRES_USER=love
POSTGRES_PASSWORD=请设置一个强密码_至少16位
POSTGRES_DB=love_node

# -------------------- Redis 配置 --------------------
REDIS_PASSWORD=请设置Redis密码_至少16位

# -------------------- 应用配置 --------------------
APP_NAME=恋爱记

# -------------------- JWT 安全配置 --------------------
# 生成强密钥的方法：
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=请生成一个64位以上的随机密钥
JWT_EXPIRE_MINUTES=10080
BOOTSTRAP_SETUP_TOKEN=请生成一个只用于首次安装的初始化令牌

# -------------------- Cookie 保险库密钥（密钥分离）--------------------
# 用于加密 Redis 中存储的网易云 Cookie / 登录 IP（一起听）。务必与
# JWT_SECRET_KEY 使用【不同】的随机值：一旦其中一个泄露，另一个仍然安全。
# 生成方法同上：python -c "import secrets; print(secrets.token_urlsafe(64))"
# 留空则回退使用 JWT_SECRET_KEY（不推荐）。轮换此值会使已存的网易云登录失效
# （需重新扫码）。
COOKIE_VAULT_KEY=请生成另一个独立的64位以上随机密钥

# -------------------- Cookie 传输安全 --------------------
# 生产 Nginx 强制 HTTPS，此值必须保持 true，使登录 Cookie 带 Secure 标志。
COOKIE_SECURE=true

# -------------------- 限流配置 --------------------
# 每个客户端 IP 对每个接口的默认上限（全局限流中间件）。登录等敏感接口另有
# 更严格的独立限制。
RATE_LIMIT_DEFAULT=600/minute

# -------------------- CORS 配置 --------------------
# 多个域名用逗号分隔，例如：
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# -------------------- 端口配置 --------------------
HTTP_PORT=80
HTTPS_PORT=443

# -------------------- 域名配置 --------------------
# 用于部署脚本输出访问地址；Nginx 接受任意 Host，证书与 DNS 仍必须匹配此域名。
DOMAIN=yourdomain.com

# -------------------- 前端 API 地址 --------------------
# 同域名部署推荐使用 /api
# 如果分开部署，可以改成完整 URL
VITE_API_BASE_URL=/api

# -------------------- 通知调度（可选）--------------------
# 每隔多少秒扫描一次纪念日、提醒和胶囊到期通知。
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_SCHEDULER_DAYS_AHEAD=7

# -------------------- 通知邮件投递（可选）--------------------
# 如果你还想保留邮件提醒，可以一并配置；不需要就保持默认关闭。
NOTIFICATION_PUSH_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USE_TLS=true
NOTIFICATION_PUSH_EMAIL_PARTNER_A=
NOTIFICATION_PUSH_EMAIL_PARTNER_B=

# -------------------- Web Push（可选）--------------------
# 为 PWA 浏览器通知生成一对 VAPID 密钥后再启用。
# 生成方式：
# py -m py_vapid --gen
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:noreply@yourdomain.com

# -------------------- Android FCM Push（可选）--------------------
# Android 客户端推送。把 Firebase 服务账号 JSON 压成单行填入；生产
# compose 没有隐式主机文件挂载，避免配置了一个容器内不存在的路径。
FCM_PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
