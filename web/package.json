{
  "name": "love-node-web",
  "version": "1.0.1",
  "private": true,
  "description": "Love Journal - a private journal + blog + real-time interaction platform for couples (Vue 3 web client)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Love Journal Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiangshanyikecong/loveblog.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/xiangshanyikecong/loveblog/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,vue,json,css}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.29.0",
    "axios": "^1.19.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "vditor": "^3.11.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
