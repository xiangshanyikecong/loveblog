{
  "name": "love-node-web",
  "version": "1.0.1",
  "private": true,
  "description": "Love Journal - a private journal + blog + real-time interaction platform for couples (Vue 3 web client)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Love Journal Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/love-node/love-node.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/love-node/love-node/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,vue,json,css}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.2",
    "vditor": "^3.11.2",
    "vue": "^3.5.11",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.47",
    "postcss-html": "^1.8.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "tailwindcss": "^3.4.14",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
