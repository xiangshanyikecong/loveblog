# 生产环境 Dockerfile - 多阶段构建
# 构建阶段固定在原生构建平台（--platform=$BUILDPLATFORM）：npm/vite 不经
# QEMU 模拟运行（QEMU 模拟 arm64 时 node 易触发 SIGILL 崩溃，且模拟执行
# 极慢）。产物 dist 是平台无关的静态文件，可直接复制进目标架构
# （amd64/arm64）的 nginx 运行镜像。
FROM --platform=$BUILDPLATFORM node:20.19.4-alpine3.22 AS builder

WORKDIR /app

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# 复制依赖文件
COPY package*.json ./
RUN npm ci

# 复制源代码
COPY . .

# 构建生产版本
RUN npm run build

# 生产阶段 - 使用 Nginx
FROM nginx:1.27.4-alpine3.21

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /app/public/NOTICE /usr/share/nginx/html/NOTICE
COPY --from=builder /app/public/THIRD_PARTY_LICENSES.md /usr/share/nginx/html/THIRD_PARTY_LICENSES.md

# 复制 Nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
