# 统一换行符，避免跨平台（尤其 Windows → Linux）协作时把 CRLF 带进
# 需要在 Linux 上执行的脚本，导致 `bad interpreter: /bin/bash^M` 之类错误。

# 默认：让 Git 自动处理文本文件的换行符
* text=auto eol=lf

# 必须为 LF 的文件（在 Linux/容器内执行或解析）
*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf

# Windows 专用脚本：保持 CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件：不做换行符转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.db        binary
*.zip       binary
*.woff      binary
*.woff2     binary
