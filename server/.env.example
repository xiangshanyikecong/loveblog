APP_NAME=Love Node API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg2://love:love@localhost:5432/love_node
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
BOOTSTRAP_SETUP_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Geocoding provider for cottage check-in. Choices: amap | baidu | tencent | nominatim.
# nominatim does NOT require GEOCODING_API_KEY (Chinese mainland place names may be inaccurate).
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# NeteaseCloudMusicApi for cottage listen-together. Internal docker service —
# do NOT expose to the public internet.
NETEASE_API_BASE_URL=http://netease:3000
COTTAGE_LISTEN_COOKIE_TTL_DAYS=30

# Spoofed client IP forwarded to NetEase to dodge "foreign/abnormal login"
# risk-control (sent as X-Real-IP / X-Forwarded-For on every upstream call).
# Leave empty to auto-pick ONE stable mainland-China IP at startup. Set a fixed
# value (ideally near where you two usually log in) to keep it deterministic
# across restarts. Use a single stable IP — do NOT rotate it per request.
NETEASE_REAL_IP=

# Background notification scheduler (event / cottage reminder / capsule unlock).
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_SCHEDULER_DAYS_AHEAD=7

# Optional email push for scheduler-generated notifications (disabled by default).
NOTIFICATION_PUSH_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USE_TLS=true
NOTIFICATION_PUSH_EMAIL_PARTNER_A=
NOTIFICATION_PUSH_EMAIL_PARTNER_B=

# Optional Web Push (PWA browser notifications). Generate VAPID keys before enabling.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:noreply@example.com

# Optional Android FCM push notifications.
FCM_PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
